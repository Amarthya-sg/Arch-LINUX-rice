{
  "// ===================================================================": "",
  "// Round Launcher — Layout Reference  (rl_layout.json)":               "",
  "// ===================================================================": "",
  "//": "",

  "// HOW THIS FILE WORKS": "",
  "// ─────────────────────────────────────────────────────────────────": "",
  "// This is the layout file consumed by round launcher.qml.": "",
  "// It controls two things:": "",
  "//   1. GEOMETRY  — ring size, gap between slices, icon sizing, etc.": "",
  "//   2. CELLS     — the actual items that appear on the wheel.": "",
  "//": "",
  "// Every geometry key is OPTIONAL. Omit any key and the launcher": "",
  "// falls back to its built-in default (listed in each comment below).": "",
  "// The only required key is 'cells', and it must be a non-empty array.": "",
  "//": "",
  "// Hot-reload: the file is watched at runtime. Save it and the wheel": "",
  "// updates live — no need to relaunch.": "",
  "//": "",
  "// Swap layout at launch:": "",
  "//   qs -p 'round launcher.qml' -- --layout rl_layout_apps.json": "",
  "//   LAYOUT_PATH=rl_layout_apps.json qs -p 'round launcher.qml'": "",
  "//": "",

  "// ─────────────────────────────────────────────────────────────────": "",
  "// GEOMETRY KEYS": "",
  "// ─────────────────────────────────────────────────────────────────": "",
  "//": "",
  "// outerR  (number, default: 260)": "",
  "//   Outer radius of the donut ring in logical pixels, BEFORE the": "",
  "//   global --scale multiplier from the theme is applied.": "",
  "//   Larger = bigger wheel. Typical range: 180 (compact) – 340 (huge).": "",
  "//": "",
  "// innerRRatio  (number, default: 0.66)": "",
  "//   Inner radius as a fraction of outerR. Controls how thick the": "",
  "//   donut band is. 0.66 means the hole is 66% of the outer radius.": "",
  "//   Lower = thicker band (more icon room). Higher = thinner band.": "",
  "//   Practical range: 0.45 (very thick) – 0.80 (very thin).": "",
  "//": "",
  "// gapDeg  (number, default: 2.4)": "",
  "//   Gap between slices in degrees. Each slice loses gapDeg/2 from": "",
  "//   each of its two edges so the gaps are centered on the dividing": "",
  "//   lines. 0 = no gap (slices touch). Larger = more breathing room.": "",
  "//   Typical range: 1.0 – 5.0.": "",
  "//": "",
  "// iconGlyphPx  (number, default: 22)": "",
  "//   Font size in pixels used for Nerd Font glyph icons and the": "",
  "//   fallback letter badge. Also the base size that iconBadgeScale": "",
  "//   multiplies to get the badge circle diameter.": "",
  "//": "",
  "// iconBadgeScale  (number, default: 1.9)": "",
  "//   Multiplier applied to iconGlyphPx to size the circular badge": "",
  "//   drawn behind each icon. 1.9 means the badge diameter is 1.9×": "",
  "//   the icon glyph size. Increase for more padding around icons.": "",
  "//": "",
  "// popOutPx  (number, default: 30)": "",
  "//   How far (in logical pixels) the OUTER edge of a slice extends": "",
  "//   outward when it is active (hovered or keyboard-selected).": "",
  "//   The inner edge stays fixed. 0 = no pop-out animation.": "",
  "//": "",
  "// hoverScale  (number, default: 1.35)": "",
  "//   Scale applied to the icon+label item inside an active slice.": "",
  "//   1.0 = no scale-up. 1.35 = icon grows 35% larger on hover.": "",
  "//": "",

  "// ─────────────────────────────────────────────────────────────────": "",
  "// TYPOGRAPHY & SPACING KEYS": "",
  "// ─────────────────────────────────────────────────────────────────": "",
  "//": "",
  "// labelFontPx  (number, default: 11)": "",
  "//   Font size in pixels for the cell name label shown below the": "",
  "//   icon inside each slice.": "",
  "//": "",
  "// labelLetterSpacing  (number, default: 0.4)": "",
  "//   Letter spacing in pixels added between characters of the slice": "",
  "//   label. A small positive value (0.3–0.6) gives all-caps labels": "",
  "//   an open, airy feel.": "",
  "//": "",
  "// centerNameFontPx  (number, default: 18)": "",
  "//   Font size in pixels for the large cell name shown in the center": "",
  "//   hub card when a slice is active.": "",
  "//": "",
  "// hintFontPx  (number, default: 10)": "",
  "//   Font size for the 'hover or use arrow keys' hint shown at the": "",
  "//   bottom of the wheel when nothing is selected yet.": "",
  "//": "",
  "// runHintFontPx  (number, default: 9)": "",
  "//   Font size for the small 'press Enter to run' hint shown in the": "",
  "//   center card when a slice is keyboard-selected.": "",
  "//": "",
  "// hintLetterSpacing  (number, default: 1)": "",
  "//   Letter spacing applied to both hint text items.": "",
  "//": "",

  "// ─────────────────────────────────────────────────────────────────": "",
  "// SIZING & LAYOUT FINE-TUNING KEYS": "",
  "// ─────────────────────────────────────────────────────────────────": "",
  "//": "",
  "// badgeSpacing  (number, default: 2)": "",
  "//   Vertical gap in pixels between the icon badge and the label": "",
  "//   text below it inside each slice.": "",
  "//": "",
  "// centerSpacing  (number, default: 6)": "",
  "//   Vertical gap in pixels between elements inside the center card": "",
  "//   (icon → name → run-hint).": "",
  "//": "",
  "// iconMargin  (number, default: 4)": "",
  "//   Padding inside the icon badge circle around the glyph/image.": "",
  "//": "",
  "// centerIconMargin  (number, default: 6)": "",
  "//   Padding inside the center card's icon badge.": "",
  "//": "",
  "// badgeBorderWidth  (number, default: 1)": "",
  "//   Border stroke width of icon badge circles (in logical pixels).": "",
  "//": "",
  "// ringBorderWidth  (number, default: 2)": "",
  "//   Border stroke width of the center hub ring circle.": "",
  "//": "",
  "// backgroundBorderWidth  (number, default: 18)": "",
  "//   Width of the soft drop-shadow halo drawn just outside the wheel.": "",
  "//   Larger = thicker, more diffuse shadow ring.": "",
  "//": "",
  "// backgroundPadding  (number, default: 24)": "",
  "//   Extra radius added to the background shadow circle beyond outerR.": "",
  "//": "",
  "// hitAreaPadding  (number, default: 20)": "",
  "//   Extra radius beyond outerR that still counts as 'on the wheel'": "",
  "//   for mouse hover detection. Prevents the cursor flickering": "",
  "//   off-slice near the outer edge.": "",
  "//": "",

  "// ─────────────────────────────────────────────────────────────────": "",
  "// GLOW / ACTIVE-SLICE OUTLINE KEYS": "",
  "// ─────────────────────────────────────────────────────────────────": "",
  "//": "",
  "// glowStrokeWidth  (number, default: 2.4)": "",
  "//   Stroke width of the colored highlight outline drawn inside the": "",
  "//   active slice. Color comes from --color-red in the theme.": "",
  "//": "",
  "// glowInset  (number, default: 1.2)": "",
  "//   How far inward from the slice edge the glow outline is offset.": "",
  "//   Keeps the stroke from being clipped by the slice boundary.": "",
  "//": "",

  "// ─────────────────────────────────────────────────────────────────": "",
  "// CENTER CARD SCALING KEYS": "",
  "// ─────────────────────────────────────────────────────────────────": "",
  "//": "",
  "// centerIconScale  (number, default: 1.8)": "",
  "//   Multiplier applied to iconBadgeSize to size the icon badge": "",
  "//   shown in the center hub card for image/svg icons.": "",
  "//": "",
  "// centerGlyphScale  (number, default: 1.6)": "",
  "//   Same as centerIconScale but applied when the center icon is a": "",
  "//   Nerd Font glyph or letter fallback.": "",
  "//": "",
  "// centerCardWidthRatio  (number, default: 1.7)": "",
  "//   Width of the center card as a multiple of the center ring's": "",
  "//   inner diameter. 1.7 means the card is 70% wider than the ring.": "",
  "//": "",

  "// ─────────────────────────────────────────────────────────────────": "",
  "// ANIMATION KEYS": "",
  "// ─────────────────────────────────────────────────────────────────": "",
  "//": "",
  "// popAnimDuration  (number, default: 180)": "",
  "//   Duration in milliseconds of the slice pop-out and icon scale-up": "",
  "//   animation when a slice becomes active.": "",
  "//": "",
  "// fadeAnimDuration  (number, default: 150)": "",
  "//   Duration in milliseconds of the opacity fade when non-active": "",
  "//   slices dim (controlled by --dimness in the theme).": "",
  "//": "",
  "// glowAnimDuration  (number, default: 120)": "",
  "//   Duration in milliseconds of the glow outline fade-in/out on": "",
  "//   the active slice.": "",
  "//": "",
  "// popOvershoot  (number, default: 2.5)": "",
  "//   Overshoot amount for the OutBack easing on pop and scale": "",
  "//   animations. Higher = more springy bounce. 0 = no overshoot.": "",
  "//   Typical range: 1.5 – 4.0.": "",
  "//": "",
  "// blurMaxVal  (number, default: 64)": "",
  "//   Maximum raw-pixel blur value that maps to MultiEffect's": "",
  "//   normalized blur=1.0. The theme's --blur is divided by this": "",
  "//   to get the 0–1 input. Raise to allow --blur values above 64.": "",
  "//": "",

  "// ─────────────────────────────────────────────────────────────────": "",
  "// CELLS ARRAY": "",
  "// ─────────────────────────────────────────────────────────────────": "",
  "//": "",
  "// cells  (array, REQUIRED)": "",
  "//   Items that appear on the wheel, one per slice. The wheel divides": "",
  "//   360° evenly by however many cells you provide. Any length works;": "",
  "//   6–12 is practical. Number keys 1–9, 0 map to cells 0–9 in order.": "",
  "//": "",
  "//   Each cell has three fields:": "",
  "//": "",
  "//   name   (string) — label in the slice and center card.": "",
  "//                     All-caps short words work best.": "",
  "//": "",
  "//   icon   (string) — two accepted forms:": "",
  "//     • Absolute path to a PNG or SVG file.": "",
  "//         '/usr/share/icons/hicolor/64x64/apps/firefox.png'": "",
  "//     • A single Nerd Font glyph character (Unicode codepoint).": "",
  "//         '\\uf120' terminal  '\\uf269' firefox  '\\uf001' music": "",
  "//         '\\uf07b' folder    '\\uf11b' gamepad  '\\uf0e0' mail": "",
  "//         '\\uf392' discord   '\\uf013' settings '\\uf023' lock": "",
  "//         '\\uf03e' image     '\\uf028' volume   '\\uf059' help": "",
  "//     Leave '' to fall back to a plain first-letter badge.": "",
  "//": "",
  "//   script (string) — shell command run via '/bin/sh -c <script>'": "",
  "//                     when the cell is activated. Wheel closes after.": "",
  "//                     Leave '' to make the cell inert.": "",
  "//": "",

  "cells": [
    {
      "// ── cell 1 (key: 1) ──────────────────────────────────────────": "",
      "// name   : label shown in the slice and center card":             "",
      "// icon   : absolute path to png/svg  OR  Nerd Font glyph char":  "",
      "// script : shell command run on activation; '' = inert":          "",
      "name":   "TERMINAL",
      "icon":   "",
      "script": ""
    },
    {
      "// ── cell 2 (key: 2) ──────────────────────────────────────────": "",
      "// name   : label shown in the slice and center card":             "",
      "// icon   : absolute path to png/svg  OR  Nerd Font glyph char":  "",
      "// script : shell command run on activation; '' = inert":          "",
      "name":   "BROWSER",
      "icon":   "",
      "script": ""
    },
    {
      "// ── cell 3 (key: 3) ──────────────────────────────────────────": "",
      "// name   : label shown in the slice and center card":             "",
      "// icon   : absolute path to png/svg  OR  Nerd Font glyph char":  "",
      "// script : shell command run on activation; '' = inert":          "",
      "name":   "FILES",
      "icon":   "",
      "script": ""
    },
    {
      "// ── cell 4 (key: 4) ──────────────────────────────────────────": "",
      "// name   : label shown in the slice and center card":             "",
      "// icon   : absolute path to png/svg  OR  Nerd Font glyph char":  "",
      "// script : shell command run on activation; '' = inert":          "",
      "name":   "MUSIC",
      "icon":   "",
      "script": ""
    },
    {
      "// ── cell 5 (key: 5) ──────────────────────────────────────────": "",
      "// name   : label shown in the slice and center card":             "",
      "// icon   : absolute path to png/svg  OR  Nerd Font glyph char":  "",
      "// script : shell command run on activation; '' = inert":          "",
      "name":   "LOCK",
      "icon":   "",
      "script": ""
    },
    {
      "// ── cell 6 (key: 6) ──────────────────────────────────────────": "",
      "// name   : label shown in the slice and center card":             "",
      "// icon   : absolute path to png/svg  OR  Nerd Font glyph char":  "",
      "// script : shell command run on activation; '' = inert":          "",
      "name":   "SCREENSHOT",
      "icon":   "",
      "script": ""
    },
    {
      "// ── cell 7 (key: 7) ──────────────────────────────────────────": "",
      "// name   : label shown in the slice and center card":             "",
      "// icon   : absolute path to png/svg  OR  Nerd Font glyph char":  "",
      "// script : shell command run on activation; '' = inert":          "",
      "name":   "VOLUME",
      "icon":   "",
      "script": ""
    },
    {
      "// ── cell 8 (key: 8) ──────────────────────────────────────────": "",
      "// name   : label shown in the slice and center card":             "",
